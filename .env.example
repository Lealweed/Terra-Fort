# Terra-Fort / terrafort.site
# Copie para .env.local no desenvolvimento local.

# URL pública/base do app
APP_URL="http://localhost:3000"

# Porta do servidor Express local
PORT="3000"

# Runtime do servidor local
NODE_ENV="development"

# Desabilita HMR em ambientes controlados (opcional)
DISABLE_HMR="false"

# Supabase (frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase (backend/admin)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe
# Em dev/local, se as chaves abaixo não forem configuradas, o checkout online fica desabilitado
# e o fluxo deve seguir pelo WhatsApp sem quebrar a interface.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLIC_KEY="pk_test_..."

# Atendimento / n8n
# Webhook principal usado pelo intake do site
N8N_SUPPORT_WEBHOOK_URL="https://seu-n8n/webhook/terrafort-site"
# Alias legado opcional, mantido por compatibilidade
N8N_WEBHOOK_URL="https://seu-n8n/webhook/terrafort-site"
# Token enviado pelo backend para autenticar a chamada no n8n
N8N_SUPPORT_WEBHOOK_TOKEN="seu-token-compartilhado"
# Token usado pelo n8n para chamar /api/agent-context
N8N_SHARED_SECRET="seu-token-compartilhado"
# Alias legado opcional para integrações antigas
AGENT_API_KEY="seu-token-compartilhado"

# WhatsApp de fallback para atendimento
VITE_SUPPORT_WHATSAPP_NUMBER="5594999346107"
# Alias backend opcional para fallback/legado
SUPPORT_WHATSAPP_NUMBER="5594999346107"

# Legado do template AI Studio — atualmente sem uso funcional no app
GEMINI_API_KEY="optional-not-used"
